# ---- Güvenlik ----
# Oturum çerezlerini ve takip linklerini imzalayan gizli anahtar (uzun, rastgele)
AUTH_SECRET=uzun-rastgele-bir-anahtar-yazin

# ---- Olga yönetici hesabı (bayileri tanımlayan kişi) ----
# Birden fazla yönetici için JSON: ADMIN_USERS_JSON='[{"username":"ramazan","password":"...","name":"Ramazan"}]'
ADMIN_USERNAME=olga
ADMIN_PASSWORD=degistirin

# ---- Kalıcı depolama ----
# Vercel → Storage → Blob oluşturup projeye bağlayın; token otomatik tanımlanır.
# Blob olmadan bayi kaydı, fiyat ayarı ve sipariş SAKLANAMAZ.
BLOB_READ_WRITE_TOKEN=

# ---- Abonelik varsayılanları ----
# Aylık abonelik ücreti (TL) ve ücretsizlik için aylık toptan alım eşiği (TL) — bilgi amaçlı, yönetim panelinde gösterilir
SUBSCRIPTION_FEE_TL=1500
FREE_THRESHOLD_TL=50000

# ---- E-posta (opsiyonel: müşteriye teklif/sipariş PDF'i) ----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
