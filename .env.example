# ---- Güvenlik ----
# Oturum imzalama anahtarı (uzun rastgele bir metin girin)
AUTH_SECRET=uzun-rastgele-bir-anahtar-yazin

# Kullanıcıları özelleştirmek için (opsiyonel — girilmezse data/users.ts kullanılır):
# USERS_JSON='[{"username":"ramazan","password":"gizli","name":"Ramazan Kaypan","role":"staff"},{"username":"bayi1","password":"gizli","name":"Bayi Firma","role":"customer"}]'

# ---- E-posta (sipariş bildirimi) ----
# Gmail için: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, uygulama şifresi kullanın
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ORDER_EMAIL_TO=olgacercevee@gmail.com

# ---- WhatsApp ----
# Seçenek 1 (önerilen): Meta WhatsApp Cloud API — sipariş otomatik gönderilir
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Sipariş mesajının gideceği numara (ülke koduyla, örn. 905xxxxxxxxx)
WHATSAPP_TO=908503057545
# Seçenek 2: Cloud API tanımlı değilse sistem wa.me linki üretir (tek tıkla gönderim)

# Patrona fiş PDF'i (WhatsApp belge mesajı) — her siparişte fiş dosya olarak gider.
# Alıcı numara(lar), virgülle ayrılabilir:
PATRON_WHATSAPP=05325099442
# Meta'da onaylanmış, belge (document) başlıklı şablonun adı ve dili.
# Boşsa serbest belge mesajı denenir (yalnızca alıcı son 24 saatte yazdıysa gider).
WHATSAPP_TEMPLATE_SIPARIS=siparis_fisi
WHATSAPP_TEMPLATE_DIL=tr

# ---- Yapay Zeka Asistanı ----
# https://platform.claude.com adresinden API anahtarı alın
ANTHROPIC_API_KEY=

# ---- SMS (NETGSM) ----
# NETGSM panelinden "API Kullanıcısı" tipinde alt kullanıcı açın.
# ÖNEMLİ: API tarafında IP kısıtlaması TANIMLAMAYIN — Vercel'in sabit IP'si
# yoktur, kısıtlama varsa tüm gönderimler 30 koduyla reddedilir.
NETGSM_USERCODE=
NETGSM_PASSWORD=
# NETGSM'de onaylanmış gönderici başlığı (ör. OLGACERCEVE)
NETGSM_HEADER=
# NETGSM istekte "appname" (uygulama adı) alanını zorunlu tutar.
# Girilmezse "olgasiparis" kullanılır.
NETGSM_APPNAME=
