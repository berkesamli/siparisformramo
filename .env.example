# ---- Güvenlik ----
# Oturum imzalama anahtarı (uzun rastgele bir metin girin)
AUTH_SECRET=uzun-rastgele-bir-anahtar-yazin

# Kullanıcıları özelleştirmek için (opsiyonel — girilmezse data/users.ts kullanılır):
# USERS_JSON='[{"username":"ramazan","password":"gizli","name":"Ramazan Kaypan","role":"staff"},{"username":"bayi1","password":"gizli","name":"Bayi Firma","role":"customer"}]'

# ---- E-posta (sipariş bildirimi) ----
# Gmail için: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, uygulama şifresi kullanın
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ORDER_EMAIL_TO=olgacercevee@gmail.com

# ---- WhatsApp ----
# Seçenek 1 (önerilen): Meta WhatsApp Cloud API — sipariş otomatik gönderilir
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Sipariş mesajının gideceği numara (ülke koduyla, örn. 905xxxxxxxxx)
WHATSAPP_TO=908503057545
# Seçenek 2: Cloud API tanımlı değilse sistem wa.me linki üretir (tek tıkla gönderim)

# Patrona fiş PDF'i (WhatsApp belge mesajı) — her siparişte fiş dosya olarak gider.
# Alıcılar, virgülle; iki nokta sonrası mesajdaki hitap (Sayın {{1}}), yoksa "Yetkili":
PATRON_WHATSAPP=05325099442:Özgür Bey,05336610287:Gültekin Bey
# Meta'da onaylanmış, belge (document) başlıklı şablonun adı ve dili. Birden çok ad
# virgülle yazılabilir; sırayla denenir, ilk kabul edilen kullanılır (onay beklerken işe yarar).
# Şablon kabul edilmezse serbest belge mesajı denenir (yalnızca alıcı son 24 saatte yazdıysa gider).
WHATSAPP_TEMPLATE_SIPARIS=siparis_fisi_v4,siparis_fisi_v3
WHATSAPP_TEMPLATE_DIL=tr

# Müşteriye fiş (WhatsApp): sipariş formunda "müşteriye bildir" işaretliyse önce
# WhatsApp ile PDF gider; numarada WhatsApp yoksa (webhook "failed") SMS'e düşülür.
# Şablon 2 değişkenli, belge başlıklı (örn. musteri_siparis_fisi). Boşsa yalnızca SMS.
WHATSAPP_TEMPLATE_MUSTERI=musteri_siparis_fisi_v2,musteri_siparis_fisi
# Meta webhook doğrulama metni (siz belirlersiniz; Meta'daki webhook ayarına aynı değer girilir).
# Callback URL: https://<site>/api/whatsapp/webhook · abone olunacak alan: messages
WHATSAPP_VERIFY_TOKEN=
# İsteğe bağlı: Meta uygulamasının App Secret'ı — webhook istekleri imzayla doğrulanır.
WHATSAPP_APP_SECRET=

# ---- Yapay Zeka Asistanı ----
# https://platform.claude.com adresinden API anahtarı alın
ANTHROPIC_API_KEY=

# ---- SMS (NETGSM) ----
# NETGSM panelinden "API Kullanıcısı" tipinde alt kullanıcı açın.
# ÖNEMLİ: API tarafında IP kısıtlaması TANIMLAMAYIN — Vercel'in sabit IP'si
# yoktur, kısıtlama varsa tüm gönderimler 30 koduyla reddedilir.
NETGSM_USERCODE=
NETGSM_PASSWORD=
# NETGSM'de onaylanmış gönderici başlığı (ör. OLGACERCEVE)
NETGSM_HEADER=
# NETGSM istekte "appname" (uygulama adı) alanını zorunlu tutar.
# Girilmezse "olgasiparis" kullanılır.
NETGSM_APPNAME=

# Mikro Jump 17 Desktop API (Ankara sunucusu; Tailscale Funnel ile dışarı açık, port 8094).
# Yalnızca okuma: cari bakiye / vade. Şifre düz metin girilir, tarihli MD5'i sistem alır.
MIKRO_API_URL=https://olgaserver.tailbbb7b8.ts.net
MIKRO_API_KEY=
MIKRO_FIRMA_KODU=001
MIKRO_KULLANICI=
MIKRO_SIFRE=
MIKRO_CALISMA_YILI=2026

# Mikro'dan stok: depo numaraları boşsa DEPOLAR'daki adına göre (ANKARA / İSTANBUL) bulunur.
# MIKRO_DEPO_ANKARA=1
# MIKRO_DEPO_ISTANBUL=2
# Çalışan stok sorgularken veri bu kadar dakikadan eskiyse Mikro'dan tazelenir (varsayılan 120)
# STOK_TAZELIK_DK=120

# Müşteri satış bölgeleri ile ilgilenen satışçılar (isteğe bağlı; varsayılanlar kodda)
# BOLGE_SORUMLULARI="ankara=Ramazan Kaypan;istanbul=Alaattin Yıldız;tasra=Murat Gündüz"

# ---- Mesajlar (gelen kutusu: WhatsApp + Instagram + Gmail tek ekranda) ----
# Postgres bağlantısı (Vercel → Storage → Neon; tablolar ilk kullanımda kendiliğinden kurulur)
DATABASE_URL=
# Gelen kutusunu görüp yanıtlayabilecek çalışanlar (virgülle; boşsa yalnızca sahipler)
MESAJ_USERNAMES=berke
# Gmail hesapları: "adres:uygulama-şifresi" çiftleri noktalı virgülle. Google hesabında 2 adımlı doğrulama
# açık olmalı; uygulama şifresi https://myaccount.google.com/apppasswords adresinden alınır (16 harf).
GMAIL_HESAPLAR="olgacercevee@gmail.com:xxxx xxxx xxxx xxxx;stasresimasmasistemleri@gmail.com:xxxx xxxx xxxx xxxx"
# Instagram (olga.cerceve — Facebook sayfasına bağlı profesyonel hesap). Meta uygulamasında "Instagram"
# ürünü + instagram_manage_messages izni (App Review); webhook: https://<site>/api/mesaj/webhook, alan: messages
INSTAGRAM_TOKEN=
INSTAGRAM_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
# Instagram webhook doğrulama metni / uygulama gizi (boşsa WHATSAPP_VERIFY_TOKEN / WHATSAPP_APP_SECRET kullanılır)
# INSTAGRAM_VERIFY_TOKEN=
# META_APP_SECRET=
